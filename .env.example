# Copy to .env (never commit .env). These override config/settings.yaml.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
MAX_EXPERIMENTAL_ALLOCATION_INR=200
MAX_SINGLE_ORDER_VALUE_INR=200
MAX_OPEN_POSITIONS=1
ALLOW_SHORT_SELLING=false
ALLOW_DERIVATIVES=false
ALLOW_LEVERAGE=false
REQUIRE_HUMAN_APPROVAL=true
# INDIA_TRADING_CONFIG=config/settings.yaml
# INDIA_TRADING_STATE_DIR=state
# No broker credentials are read by this release. Never put tokens, PINs or
# TOTP secrets in this file or in chat.
