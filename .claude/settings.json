{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" -m india_trading.live.guard",
            "shell": "bash",
            "timeout": 20,
            "onFailure": "block",
            "statusMessage": "Live guard: checking MCP tool call"
          }
        ]
      }
    ]
  }
}
