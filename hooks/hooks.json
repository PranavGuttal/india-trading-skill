{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.sh\"",
            "timeout": 20,
            "onFailure": "block",
            "statusMessage": "Live guard: checking MCP tool call"
          }
        ]
      }
    ]
  }
}
